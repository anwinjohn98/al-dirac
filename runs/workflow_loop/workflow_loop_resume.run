#!/bin/bash
#SBATCH --job-name=workflow_loop_resume
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --ntasks=64
#SBATCH --mail-user=john51@purdue.edu
#SBATCH --time=01:00:00
#SBATCH --partition=smallgpu
#SBATCH --qos=normal
#SBATCH --account=jgreeley
#SBATCH --output=/scratch/gautschi/john51/al_dirac/runs/workflow_loop/slurm-resume-%j.out
#SBATCH --error=/scratch/gautschi/john51/al_dirac/runs/workflow_loop/slurm-resume-%j.err

REPO_ROOT=/scratch/gautschi/john51/al_dirac
cd "$REPO_ROOT"

apptainer exec --nv --cleanenv \
  --bind "$REPO_ROOT":/workspace \
  al_dirac-python.sif \
  bash -c "cd /workspace && export PATH=/usr/local/bin:/usr/bin:/bin LD_LIBRARY_PATH=/.singularity.d/libs CC=/usr/bin/gcc CXX=/usr/bin/g++ && python examples/workflow_loop.py resume"

sbatch "$REPO_ROOT/runs/workflow_loop/workflow_loop_explore.run"
